# wifi-provision configuration
#
# Installed to /opt/wifi-provision/config.env by install.sh.
# Loaded into the systemd service's environment via EnvironmentFile=,
# so both bin/wifi-provision (bash) and portal/app.py (python) see these
# automatically — no need to source this file by hand.
#
# Edit this file, then:
#   sudo systemctl restart wifi-provision.service
# to pick up changes without a full reboot. If you change AP_SSID/AP_PASSWORD
# you also need to re-run: sudo ./install.sh   (it updates the Hotspot profile)

# --- Access point (setup hotspot) ---
AP_SSID=PiSetup
AP_PASSWORD=changeme123
AP_IFACE=wlan0
AP_CON_NAME=Hotspot

# --- Portal web server ---
PORTAL_PORT=80

# --- Captive portal auto-popup (v2 feature, see README "Captive portal
# auto-popup") ---
# true:  install a DNS wildcard for the AP's dnsmasq + iptables rules so
#        phones' OS-level captive-portal detectors pop the sign-in page
#        automatically.
# false: skip both — back to "join PiSetup, open 10.42.0.1 by hand".
# Toggling this requires re-running install.sh to add/remove the files.
CAPTIVE_PORTAL=true
# Must match the address NetworkManager's ipv4.method=shared actually
# assigns the Pi on the AP (confirm with `ip addr show wlan0` while the
# Hotspot is up) — 10.42.0.1 is NetworkManager's standard default.
AP_GATEWAY=10.42.0.1

# --- Connectivity checking ---
# URL used to confirm real internet reachability after a connect attempt
# (also used for the "are we already online" check at boot).
CONNECTIVITY_CHECK_URL=http://connectivitycheck.gstatic.com/generate_204
# Seconds to wait for a new connection to prove itself before rolling back.
CONNECT_TIMEOUT=20
# Seconds to wait for connectivity at boot before falling back to AP mode.
BOOT_CHECK_TIMEOUT=20

# --- State ---
MARKER_FILE=/var/lib/wifi-provision/configured

# --- Hand-off ---
# Name of your existing systemd unit to kick explicitly once Wi-Fi is up
# (belt-and-suspenders alongside network-online.target ordering).
# Leave blank to rely solely on network-online.target.
EXISTING_SERVICE=jukebox.service
